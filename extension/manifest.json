{
  "manifest_version": 3,
  "name": "RatMobile",
  "short_name": "RatMobile",
  "version": "0.1.0",
  "description": "Tablet-style Chromium: pages always fit the width (no horizontal scrolling), slide-over vertical tab dock with pinned tabs, crash-proof session snapshots.",
  "homepage_url": "https://github.com/dixonSolutions/RatMobile",
  "key": "",
  "update_url": "https://dixonsolutions.github.io/RatMobile/updates.xml",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "sessions",
    "sidePanel",
    "favicon",
    "scripting",
    "search",
    "topSites",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/ratmobile.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/dock.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "ui/newtab.html"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "action": {
    "default_title": "RatMobile tabs",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "ui/options.html",
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open / close the tab overlay"
    },
    "toggle-fit": {
      "description": "Toggle fit-to-width on this site"
    }
  }
}
