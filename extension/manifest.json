{
  "manifest_version": 3,
  "name": "RatMobile",
  "short_name": "RatMobile",
  "version": "0.1.0",
  "description": "Tablet-style Chromium: pages always fit the width (no sideways scrolling), crash-proof session snapshots. Pairs with Chromium's own vertical tabs.",
  "homepage_url": "https://github.com/dixonSolutions/RatMobile",
  "key": "",
  "update_url": "https://dixonsolutions.github.io/RatMobile/updates.xml",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "sessions",
    "favicon",
    "scripting",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/ratmobile.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "RatMobile",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "ui/options.html",
  "commands": {
    "toggle-fit": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle fit-to-width on this site"
    }
  }
}
